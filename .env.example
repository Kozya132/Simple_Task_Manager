TODO_TRACKER_POSTGRES_USER=todo_tracker
TODO_TRACKER_POSTGRES_PASSWORD=replace_with_random_password
TODO_TRACKER_POSTGRES_DB=todo_tracker
TODO_TRACKER_POSTGRES_PORT=5433
TODO_TRACKER_API_PORT=8001

# Local Python uses localhost; Compose overrides this with its postgres hostname.
TODO_TRACKER_DATABASE_URL=postgresql+asyncpg://todo_tracker:replace_with_random_password@127.0.0.1:5433/todo_tracker
TODO_TRACKER_JWT_SECRET=replace_with_random_secret
TODO_TRACKER_JWT_EXPIRE_MINUTES=30
